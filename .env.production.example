# Copy to .env.production and replace every CHANGE_ME value before deployment.
COMPOSE_PROJECT_NAME=qualive_inviter
IMAGE_TAG=prod

# Public DNS name pointed at this server. Caddy will request TLS automatically.
APP_DOMAIN=inviter.example.com
APP_ENV=production
APP_DEBUG=false
APP_DOCS_ENABLED=false
APP_ALLOW_REGISTRATION=false
APP_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARACTERS
APP_CORS_ORIGINS=https://inviter.example.com
APP_ALLOWED_HOSTS=inviter.example.com,127.0.0.1,localhost,backend
LOG_LEVEL=INFO
LOG_JSON=true

POSTGRES_DB=inviter
POSTGRES_USER=inviter
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD

WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2

# Telegram .session files are stored in a named Docker volume at /data/sessions.
SESSIONS_DIR=/data/sessions
