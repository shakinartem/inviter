# Copy to .env.production, chmod 600, and replace every CHANGE_ME/example value.
COMPOSE_PROJECT_NAME=qualive_inviter

# Public DNS name already pointing at this server. Caddy obtains TLS automatically.
APP_DOMAIN=inviter.example.com

# Generate independently, e.g. `openssl rand -hex 48` for each secret.
APP_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARACTERS
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD

POSTGRES_DB=inviter
POSTGRES_USER=inviter

# Keep single-process defaults while Telegram sessions are shared on one VPS.
WEB_CONCURRENCY=1
CELERY_CONCURRENCY=1

# Connection pool / dependency timeout bounds.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
REDIS_SOCKET_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO
LOG_JSON=true
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5

# deploy/deploy.sh derives an immutable image tag from the Git commit/archive timestamp.
# Override only when you deliberately manage release tags yourself.
# RELEASE_TAG=2026.08.20-1

# Backup policy used by deploy/backup.sh.
BACKUP_ROOT=backups
BACKUP_RETENTION_DAYS=14
